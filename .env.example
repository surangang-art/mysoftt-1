# ---- Market data provider ----
# One of: twelvedata | oanda | demo
# If unset: twelvedata when TWELVEDATA_API_KEY exists, else oanda when OANDA_API_KEY exists, else demo.
DATA_PROVIDER=

# Twelve Data (https://twelvedata.com) - symbol XAU/USD
TWELVEDATA_API_KEY=

# OANDA v20 REST (https://developer.oanda.com) - instrument XAU_USD
OANDA_API_KEY=
# practice | live
OANDA_ENV=practice

# How often the browser polls for new candles (ms). Defaults: demo 2000, oanda 5000, twelvedata 60000.
# Twelve Data's free plan allows ~800 requests/day, so keep this high unless you are on a paid plan.
POLL_INTERVAL_MS=

# ---- Telegram alerts ----
# Create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Background worker (npm run worker) ----
WORKER_TIMEFRAMES=15m,1h
# Lowest signal level the worker sends: STRONG (only STRONG BUY/SELL) or ANY
WORKER_MIN_LEVEL=STRONG
WORKER_INTERVAL_MS=60000
